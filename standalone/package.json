{
  "name": "fatfish-pet-standalone",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Standalone Electron desktop host for the FatFish desktop pet: transparent always-on-top window, local model config, permission-graded agent.",
  "main": "main.cjs",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "electron .",
    "capture": "electron . --capture=shot.png",
    "build:boot": "powershell -NoProfile -ExecutionPolicy Bypass -File build-boot.ps1",
    "test": "node test-standalone.mjs"
  },
  "dependencies": {
    "electron": "31.7.7",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "0.21.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}

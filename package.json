{
  "name": "@local/fatfish-pet",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "A Live2D-style blue-haired whale-maid pet for the Harness Web UI: physics, expressions, chat, voice and memory.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "live2d-bundle.js",
    "live2d/**",
    "live2d-src/**",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "docs/**",
    "art/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/wangruiyu589-design/fatfish-pet.git"
  },
  "homepage": "https://github.com/wangruiyu589-design/fatfish-pet#readme",
  "bugs": {
    "url": "https://github.com/wangruiyu589-design/fatfish-pet/issues"
  }
}
